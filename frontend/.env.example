# Copy this file to .env and fill in the real values. .env is git-ignored.

# Base URL of the backend (backend/), no trailing slash. Must be prefixed EXPO_PUBLIC_ to
# be readable from client code — see lib/api/client.ts.
EXPO_PUBLIC_API_URL="http://localhost:4000"

# "true" makes every screen use its feature folder's mock.ts instead of the backend above —
# for working on layout without the backend running. See lib/api/flags.ts.
EXPO_PUBLIC_USE_MOCK_DATA="false"
