# Copy this file to .env and fill in the real values. .env is git-ignored.

# Postgres connection string. Must point at a database where you can run
# CREATE EXTENSION — pgvector is enabled by the first migration.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Port the Express server listens on.
PORT=4000

# Secret used to sign and verify access token JWTs. Use a long random string —
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
JWT_SECRET="change-me"

# OpenAI API key, used only to turn text into embedding vectors for feed matching
# (retrieval — no model generates any text in the product). Without it, businesses and
# requirements are stored with no embedding and the feed falls back to category and
# service-area matching. Run `npm run backfill-embeddings` after adding the key.
OPENAI_API_KEY="sk-..."

# Optional. Must output 1536 dimensions to fit the vector(1536) columns.
# EMBEDDING_MODEL="text-embedding-3-small"
